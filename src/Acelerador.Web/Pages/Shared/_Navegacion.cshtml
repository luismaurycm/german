@model ModeloNavegacion
@{
    var visibles = Pasos.Visibles(Model.Cliente);
    var actual = Pasos.Indice(Model.Cliente.PasoActual);
}
<nav class="a-nav" aria-label="Pasos de la implementación">
    <h2>Pasos</h2>
    <ol>
        @for (var i = 0; i < visibles.Count; i++)
        {
            var paso = visibles[i];
            var indice = Pasos.Indice(paso.Codigo);
            var conError = paso.Codigo == Pasos.Ejecucion && Model.Cliente.Estado == EstadoCliente.ConError;
            var completo = indice < actual || (paso.Codigo == Pasos.Ejecucion && Model.Cliente.Estado == EstadoCliente.Completo);
            var estado = conError ? "Con error" : completo ? "Completo" : indice == actual ? "Actual" : "Pendiente";
            var icono = conError ? Iconos.Error : completo ? Iconos.Ok : indice == actual ? Iconos.Actual : Iconos.Pendiente;
            var visto = paso.Codigo == Model.PasoVisto;
            <li>
                @if (ReglaAvance.PuedeAbrir(Model.Cliente, paso.Codigo))
                {
                    <a class="step" href="@Formato.Ruta(Model.Cliente.Id, paso.Codigo)" aria-current="@(visto ? "step" : null)" data-carga="@Formato.Carga(paso.Codigo)">
                        @icono<span class="t">@(i + 1). @paso.Nombre</span><span class="s @(conError ? "err" : completo ? "ok" : "")">@estado</span>
                    </a>
                }
                else
                {
                    <span class="step" aria-current="@(visto ? "step" : null)">
                        @icono<span class="t">@(i + 1). @paso.Nombre</span><span class="s">@estado</span>
                    </span>
                }
            </li>
        }
    </ol>
    <a class="step reg" href="@Formato.Registro(Model.Cliente.Id)" aria-current="@(Model.PasoVisto == "registro" ? "page" : null)">
        <span class="t">Registro de ejecuciones</span>
    </a>
    @if (ReglaAvance.PuedeAbrir(Model.Cliente, Pasos.Reportes))
    {
        <h2 class="nav-sub">Plantillas del cierre</h2>
        <a class="step" href="@Formato.Reporte(Model.Cliente.Id, "C01")" aria-current="@(Model.PasoVisto == "C01" ? "page" : null)" data-carga="Actualizando C01…">
            <span class="t">C01 Conciliación intercompañía</span>
        </a>
        <a class="step" href="@Formato.Participaciones(Model.Cliente.Id)" aria-current="@(Model.PasoVisto == "c02" ? "page" : null)" data-carga="Consultando el modelo de propiedad…">
            <span class="t">C02 Participaciones y métodos</span>
        </a>
        <a class="step" href="@Formato.Reporte(Model.Cliente.Id, "C03")" aria-current="@(Model.PasoVisto == "C03" ? "page" : null)" data-carga="Actualizando C03…">
            <span class="t">C03 Validación de cuadre</span>
        </a>
        <a class="step" href="@Formato.Cierre(Model.Cliente.Id)" aria-current="@(Model.PasoVisto == "C04" ? "page" : null)" data-carga="Consultando el estado del cierre…">
            <span class="t">C04 Estado del cierre</span>
        </a>
        @if (Model.Cliente.Modulos.Contains(Modulo.Presupuesto))
        {
            <a class="step" href="@Formato.Presupuesto(Model.Cliente.Id)" aria-current="@(Model.PasoVisto == "P05" ? "page" : null)" data-carga="Consultando el modelo de planeación…">
                <span class="t">P05 Captura de presupuesto</span>
            </a>
        }
        <a class="step" href="@Formato.Asientos(Model.Cliente.Id)" aria-current="@(Model.PasoVisto == "asientos" ? "page" : null)" data-carga="Consultando los asientos del periodo…">
            <span class="t">Asientos de ajuste</span>
        </a>
    }
</nav>
