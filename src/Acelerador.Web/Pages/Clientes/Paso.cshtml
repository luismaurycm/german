@page "/clientes/{id:guid}/paso/{codigo}"
@model Acelerador.Web.Pages.Clientes.PasoModel
@{
    ViewData["Title"] = Model.Paso.Nombre;
}
<div class="a-body">
    <partial name="_Navegacion" model="@(new ModeloNavegacion(Model.Cliente, Model.Paso.Codigo))" />
    <main class="a-main" id="contenido">
        <div class="ph">
            <div>
                <h1>@Model.Paso.Nombre</h1>
                <p>@Model.Paso.Codigo · @Model.Paso.Historias</p>
            </div>
        </div>
        <div class="card empty">
            @Iconos.Vacio
            <p class="big">Esta pantalla llega en un sprint posterior.</p>
            <p class="muted">Se construye con @Model.Paso.Historias del backlog.</p>
        </div>
    </main>
</div>
